  "narrative": {
    "northStar": "Clareza com presença",
    "overview": "O logo champanhe e bronze de Nathália Bastos orienta uma identidade de tons quentes, com preto quente nas superfícies escuras e marfim na leitura. Marcellus traz proporções clássicas e terminais discretos; Manrope mantém a leitura clara nos textos e controles.",
    "keyCharacteristics": [
      "Logo original sobre preto quente, sem distorção ou recoloração.",
      "Champanhe nas ações e bronze profundo no texto sobre claro.",
      "Marcellus nos títulos e Manrope nos textos e controles.",
      "Superfícies planas, divisórias finas e imagens fornecidas.",
      "Hero, processo, avaliações e rodapé em preto quente, alternados com superfícies claras."
    ],
    "rules": [
      {
        "name": "The Logo Integrity Rule",
        "body": "Preservar o arquivo original, suas proporções e cores; apresentar o logo sobre uma superfície escura.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Usar superfícies e divisórias para hierarquia; reservar a sombra ao diálogo.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preservar as proporções e os arquivos originais.",
      "Do usar bronze profundo para destaques sobre claro e champanhe com texto escuro nas ações.",
      "Do manter foco visível, leitura responsiva e movimento reduzido."
    ],
    "donts": [
      "Don't usar champanhe como texto pequeno sobre branco.",
      "Don't ampliar excessivamente o retrato de resolução reduzida.",
      "Don't adicionar credenciais, avaliações ou contatos sem fonte."
    ]
  }
